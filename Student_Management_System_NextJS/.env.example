# Copy to .env.local for local development.
# On Vercel, add the same keys under Project Settings -> Environment Variables.

# MongoDB Atlas connection string (Vercel can't reach a local MongoDB)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/student_management_system?retryWrites=true&w=majority

# Long random string used to sign the login cookie
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Optional: comma-separated DNS servers for resolving mongodb+srv:// locally
# (only if your network's DNS can't resolve Atlas SRV records). Leave unset on Vercel.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
